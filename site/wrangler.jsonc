{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eduthart",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Wrangler's bundler wraps functions in __name(...) to keep their names. The
  // theme script is a function turned into a string and run in the browser,
  // where __name does not exist, so every page threw "__name is not defined".
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "eduthart",
    },
  ],
  // Outbound email (Cloudflare Email Service). The sender, support@eduthart.com,
  // must be on a domain onboarded under Compute > Email Service > Email Sending.
  // No destination restriction, so it can mail any customer. See src/lib/email/send.ts.
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
