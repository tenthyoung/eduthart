# Firebase Admin — used by every server route that reads or writes user data.
FIREBASE_ADMIN_PROJECT_ID=eduthart-5dd68
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Absolute site URL, used for links inside notification emails and invoices.
NEXT_PUBLIC_SITE_URL=https://www.eduthart.com

# Stripe — required for checkout, saved cards, and order fulfilment.
# Use test-mode keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Webhooks are rejected without it.
STRIPE_WEBHOOK_SECRET=

# Resend — notification and transactional email. Notifications still appear in
# the in-app centre when this is unset; only the email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL="EduthArt <support@eduthart.com>"
CONTACT_EMAIL=
