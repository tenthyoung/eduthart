# Firebase Admin — used by every server route that reads or writes user data.
# All three are required together: with only some of them set, the server falls
# back to application default credentials and every such route fails. Take the
# client email and private key from a service account key in the Firebase
# console. (On Google infrastructure, or with GOOGLE_APPLICATION_CREDENTIALS
# pointing at a key file, application default credentials are used instead and
# these can be left unset.)
FIREBASE_ADMIN_PROJECT_ID=eduthart-5dd68
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Absolute site URL, used for links inside notification emails and invoices.
NEXT_PUBLIC_SITE_URL=https://www.eduthart.com

# Stripe — required for checkout, saved cards, and order fulfilment.
# Use test-mode keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Webhooks are rejected without it.
STRIPE_WEBHOOK_SECRET=

# Shippo — live shipping rates, labels, and tracking. Without a token the site
# still sells: shipping falls back to the artist's own stated domestic rate and
# no label is bought. Test tokens (shippo_test_...) issue labels that are never
# charged.
SHIPPO_API_TOKEN=
# Any long random string. Put the same value in the `token` query parameter of
# the Shippo "Track Updated" webhook URL:
#   POST /api/commerce/shipping-webhook?token=<this value>
SHIPPO_WEBHOOK_SECRET=

# Resend — notification and transactional email. Notifications still appear in
# the in-app centre when this is unset; only the email is skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL="EduthArt <support@eduthart.com>"
CONTACT_EMAIL=
