# Firebase Admin — used by every server route that reads or writes user data.
# All three are required together. Take the client email and private key from a
# service account key in the Firebase console. Application default credentials
# are not supported: the site runs on Cloudflare Workers, which have none.
# (The Firebase emulators are the exception: set FIRESTORE_EMULATOR_HOST and/or
# FIREBASE_AUTH_EMULATOR_HOST plus the project id and no key is needed.)
FIREBASE_ADMIN_PROJECT_ID=eduthart-5dd68
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Absolute site URL, used for links inside notification emails and invoices.
NEXT_PUBLIC_SITE_URL=https://eduthart.com

# Stripe — required for checkout, saved cards, and order fulfilment.
# Use test-mode keys (sk_test_...) outside production.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard. Webhooks are rejected without it.
STRIPE_WEBHOOK_SECRET=

# Shippo — live shipping rates, labels, and tracking. Without a token the site
# still sells: shipping falls back to the artist's own stated domestic rate and
# no label is bought. Test tokens (shippo_test_...) issue labels that are never
# charged.
SHIPPO_API_TOKEN=
# Any long random string. Put the same value in the `token` query parameter of
# the Shippo "Track Updated" webhook URL:
#   POST /api/commerce/shipping-webhook?token=<this value>
SHIPPO_WEBHOOK_SECRET=

# Email is sent through Cloudflare Email Service via the EMAIL binding in
# wrangler.jsonc, as support@eduthart.com. There is no key to set. Under plain
# `next dev` there is no binding, so notifications still appear in the in-app
# centre and only the email is skipped.
# Where contact-form messages and reports go. Defaults to support@eduthart.com.
CONTACT_EMAIL=

# Google Places (the "New" Places API) — the city search on profile and
# artist-application location fields. Optional: without it those fields are
# plain city / region / country inputs. Server-side only; never expose it as
# NEXT_PUBLIC_. In Google Cloud, enable "Places API (New)" and restrict the key
# to that API. Set in production with `wrangler secret put GOOGLE_PLACES_API_KEY`.
GOOGLE_PLACES_API_KEY=
